# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Server-side Google Maps API Key for Geocoding V4 REST API requests
GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Client-side Google Maps API Key for Google Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Discovery storage and ingestion. No live feed is assumed to be verified.
PORT=3000
HOPSCOUT_DATA_FILE=data/youth-events.json
# Set a private server-only token to enable external batch ingestion.
HOPSCOUT_INGEST_TOKEN=
# Supply reviewed RSS/Atom feeds as JSON: [{"name":"Organizer","url":"https://...","county":"snohomish","city":"Everett"}]
HOPSCOUT_FEEDS=[]
# Optional destination for the standalone collector; defaults to localhost:$PORT.
API_INGEST_URL=

# Optional persistent embedded database directory; default database/.local/hopscout
HOPSCOUT_DB_DIR=
